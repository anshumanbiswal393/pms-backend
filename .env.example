SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=*

CORS_ALLOWED_ORIGINS=https://app.dev.retrod.in
CSRF_TRUSTED_ORIGINS=https://app.dev.retrod.in,https://app.dev.retrod.in:8443

DATABASE_URL=postgres://retrod:change-me@db:5432/retrod

REDIS_URL=redis://redis:6379/1

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=no-reply@retrod.io

OTP_PROVIDER=mock

# Postgres container credentials (must match DATABASE_URL above)
POSTGRES_DB=retrod
POSTGRES_USER=retrod
POSTGRES_PASSWORD=change-me

# Frontend build-time vars (used by docker-compose to build the frontend image)
VITE_API_URL=https://app.dev.retrod.in:8443
VITE_SU_API_URL=
VITE_SU_API_KEY=
VITE_RAZORPAY_KEY_ID=
